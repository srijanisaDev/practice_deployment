# Contact form (Gmail SMTP via Nodemailer)
# Copy this file to .env.local for local development and fill in real values.
# In production, set these in the Vercel dashboard -> Project Settings -> Environment Variables.
# Do NOT commit real values.

# The Gmail address that SENDS the message (your sending account)
GMAIL_USER=

# The 16-character Gmail App Password (NOT your normal Gmail password)
GMAIL_APP_PASSWORD=

# The address that RECEIVES contact form submissions (where you want to be notified)
CONTACT_TO_EMAIL=
